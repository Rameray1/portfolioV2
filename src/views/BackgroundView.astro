---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getBackground } from '../lib/background';
import { formatMonth } from '../lib/dates';
import Highlights from '../components/Highlights.astro';
import Piece from '../components/Piece.astro';
import Trait from '../components/Trait.astro';
import { stepPiece } from '../lib/pieces';
import { getLocale, useTranslations } from '../i18n/utils';

const locale = getLocale(Astro.currentLocale);
const t = useTranslations(locale);
const entries = await getBackground(locale);
---

<BaseLayout
  title={t('background.title')}
  description={t('background.description')}
>
  <h1>{t('background.title')}</h1>
  <div class="head" aria-hidden="true">
    <span>{t('background.col.period')}</span>
    <span>{t('background.col.title')}</span>
    <span>{t('background.col.place')}</span>
  </div>
  <ol>
    {entries.map((entry) => (
      <li id={entry.id}>
        <div class="when">
          <p class="year" aria-hidden="true">
            {entry.start.slice(0, 4)}
          </p>
          <p class="period">
            {entry.start === entry.end ? (
              <time datetime={entry.start}>
                {formatMonth(entry.start, locale)}
              </time>
            ) : (
              <>
                <span>
                  <time datetime={entry.start}>
                    {formatMonth(entry.start, locale)}
                  </time>
                  {' –'}
                </span>{' '}
                <span>
                  {entry.end ? (
                    <time datetime={entry.end}>
                      {formatMonth(entry.end, locale)}
                    </time>
                  ) : (
                    <span class="now">
                      <Trait small />
                      {t('background.present')}
                    </span>
                  )}
                </span>
              </>
            )}
          </p>
          <p class="kind">{t(`background.${entry.kind}`)}</p>
        </div>
        <span class="node" aria-hidden="true">
          <Piece name={stepPiece[entry.kind]} class="piece" />
        </span>
        <h2>{entry.title}</h2>
        <p class="place">{entry.place}</p>
        <p class="detail">{entry.detail}</p>
        {entry.tech.length > 0 && (
          <ul class="tech" aria-label={t('projects.tech')}>
            {entry.tech.map((name) => (
              <li>{name}</li>
            ))}
          </ul>
        )}
        <Highlights items={entry.highlights} class="highlights" />
      </li>
    ))}
  </ol>
</BaseLayout>

<style>
  h1 {
    margin: 0 0 var(--space-6);
  }

  ol,
  ul {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  ol {
    border-top: var(--rule-heavy) solid var(--color-rule);
  }

  /* Une seule colonne sur mobile : une colonne de dates à côté de l'intitulé tassait la
     tête de l'étape. */
  ol > li {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr);
    align-items: baseline;
    padding-block: var(--space-5);
    border-bottom: var(--rule-thin) solid var(--color-rule-soft);
    --quiet: var(--color-ink-muted);
    transition: color var(--duration) var(--ease-out);
  }

  ol > li > * {
    grid-column: 1 / -1;
    margin: 0;
    overflow-wrap: anywhere;
  }

  ol > li > .when {
    display: contents;
    font-size: var(--text-sm);
  }

  .when p {
    margin: 0;
  }

  .year {
    grid-row: 1;
    grid-column: 1;
    font-size: var(--text-2xl);
    font-weight: var(--weight-black);
    font-stretch: var(--stretch-display);
    line-height: 1;
  }

  .period,
  .kind {
    grid-row: 4;
    margin-top: var(--space-2);
    color: var(--quiet);
  }

  .period {
    grid-column: 1;
  }

  .period .now {
    display: inline;
    font-weight: var(--weight-semibold);
    color: var(--color-ink);
    transition: color var(--duration) var(--ease-out);
  }

  .period span {
    white-space: nowrap;
  }

  .kind {
    grid-column: 2;
  }

  .kind::before {
    content: '\00a0· ' / '';
  }

  /* Pièce de 1.5rem sur mobile, 1.75rem sur le fil (DESIGN.md). */
  ol > li > .node {
    grid-column: 2;
    grid-row: 1;
    justify-self: end;
    align-self: start;
    --piece: 1.5rem;
    margin-top: calc((var(--text-2xl) - var(--piece)) / 2);
  }

  .node .piece {
    width: var(--piece);
    height: var(--piece);
    transition: transform var(--duration) var(--ease-out);
  }

  ol > li > h2 {
    grid-row: 2;
    margin-top: var(--space-3);
    font-size: var(--text-lg);
    font-weight: var(--weight-bold);
    line-height: var(--leading-snug);
  }

  ol > li > .place {
    grid-row: 3;
    margin-top: var(--space-1);
    font-size: var(--text-sm);
    font-weight: var(--weight-semibold);
  }

  ol > li > .detail {
    max-width: var(--measure);
    margin-top: var(--space-3);
  }

  ol > li > .tech {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    margin-top: var(--space-3);
    font-size: var(--text-sm);
  }

  .tech li {
    padding: var(--space-1) var(--space-3);
    border: var(--rule-thin) solid currentColor;
    line-height: var(--leading-snug);
  }

  ol > li > .highlights {
    max-width: var(--measure);
    margin-top: var(--space-3);
  }

  .head {
    display: none;
  }

  /* Pas au toucher : l'état resterait collé après un appui. */
  @media (hover: hover) {
    ol:hover > li:not(:hover) {
      color: var(--color-ink-muted);
    }

    ol:hover > li:not(:hover) .now {
      color: inherit;
    }

    ol > li:hover {
      --quiet: var(--color-ink);
    }
  }

  @media (hover: hover) and (prefers-reduced-motion: no-preference) {
    ol > li:hover > .node .piece {
      transform: translateY(calc(-1 * var(--space-1)));
    }
  }

  /* 12.5rem : « sept. 2024 – ■ aujourd’hui » sur une ligne. */
  @media (min-width: 56rem) {
    .head,
    ol > li {
      grid-template-columns: 12.5rem 1.75rem minmax(0, 1fr) minmax(
          10rem,
          16rem
        );
      column-gap: var(--space-5);
    }

    .head {
      display: grid;
      padding-bottom: var(--space-2);
      border-bottom: var(--rule-heavy) solid var(--color-rule);
      font-size: var(--text-sm);
      font-weight: var(--weight-bold);
    }

    .head span:nth-child(2) {
      grid-column: 3;
    }

    ol {
      border-top: 0;
    }

    ol > li {
      grid-template-rows: none;
      padding-block: var(--space-5);
    }

    ol > li > *,
    ol > li > h2 {
      grid-column: 3;
    }

    ol > li > .when {
      display: block;
      grid-column: 1;
      grid-row: 1 / span 6;
    }

    .kind {
      margin-top: var(--space-1);
      font-weight: var(--weight-semibold);
      color: inherit;
    }

    .kind::before {
      content: none;
    }

    ol > li > h2 {
      grid-row: auto;
      margin-top: 0;
    }

    ol > li > .node {
      grid-column: 2;
      grid-row: 1 / span 6;
      justify-self: auto;
      align-self: stretch;
      position: relative;
      --piece: 1.75rem;
      margin-top: 0;
    }

    /* Le fil traverse la marge interne pour rejoindre la pièce suivante. */
    ol > li > .node::before {
      content: '';
      position: absolute;
      top: calc(-1 * var(--space-5));
      bottom: calc(-1 * var(--space-5) - var(--rule-thin));
      left: calc(50% - var(--rule-thin) / 2);
      border-left: var(--rule-thin) solid var(--color-rule);
    }

    ol > li:first-child > .node::before {
      top: calc(var(--text-2xl) / 2);
    }

    ol > li:last-child > .node::before {
      bottom: auto;
      height: calc(var(--space-5) + var(--text-2xl) / 2);
    }

    /* Le fond papier coupe le fil derrière la pièce. */
    .node .piece {
      position: relative;
      margin-top: calc((var(--text-2xl) - var(--piece)) / 2 - var(--space-1));
      padding-block: var(--space-1);
      box-sizing: content-box;
      background: var(--color-paper);
    }

    ol > li > .place {
      grid-column: 4;
      /* Un lieu sur deux lignes ne doit pas écarter l'intitulé de sa description. */
      grid-row: 1 / span 6;
      align-self: baseline;
      margin-top: 0;
      font-size: var(--text-base);
    }
  }
</style>
