---
import { render } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import Prose from '../components/Prose.astro';
import { site } from '../data/site';
import { formatDate } from '../lib/dates';
import { getLegalPage } from '../lib/pages';
import { getLocale, useTranslations } from '../i18n/utils';

const locale = getLocale(Astro.currentLocale);
const t = useTranslations(locale);
const { entry, summary, updated } = await getLegalPage(locale);
const { Content } = await render(entry);
---

<BaseLayout title={entry.data.title} description={entry.data.description}>
  <article class="legal">
    <h1>{entry.data.title}</h1>
    <p class="summary">{summary}</p>
    <dl class="pgn">
      <div>
        <dt>{t('legal.editor')}</dt>
        <dd>
          {site.name}, {t('legal.editorStatus')}
        </dd>
      </div>
      <div>
        <dt>{t('legal.director')}</dt>
        <dd>{site.name}</dd>
      </div>
      <div>
        <dt>{t('legal.contact')}</dt>
        <dd>
          <a href={`mailto:${site.contact.email}`}>{site.contact.email}</a>
        </dd>
      </div>
      <div>
        <dt>{t('legal.host')}</dt>
        <dd>
          <a href={site.host.url}>{site.host.name}</a>
          <span class="address">{site.host.address}</span>
        </dd>
      </div>
      <div>
        <dt>{t('legal.updated')}</dt>
        <dd>
          <time datetime={updated}>{formatDate(updated, locale)}</time>
        </dd>
      </div>
    </dl>
    <Prose class="text">
      <Content />
    </Prose>
  </article>
</BaseLayout>

<style>
  /* Comme le titre de l'À propos : un filet de 2 px qui traverse la page. */
  h1 {
    margin: 0;
    padding-bottom: var(--space-4);
    border-bottom: var(--rule-heavy) solid var(--color-rule);
  }

  /* En-tête de partie, comme sur la page projet : entre un filet épais et un filet fin. */
  .pgn {
    margin-top: var(--space-6);
    border-bottom: var(--rule-thin) solid var(--color-rule);
  }

  .pgn dd {
    overflow-wrap: anywhere;
  }

  .address {
    display: block;
    font-weight: var(--weight-regular);
  }

  .text {
    max-width: var(--measure);
    margin-top: var(--space-6);
  }

  /* Le résumé, comme sur la page projet. */
  .summary {
    max-width: 40ch;
    margin: var(--space-5) 0 0;
    font-size: var(--text-xl);
    line-height: var(--leading-snug);
  }

  /* La mention de l'éditeur ouvre le texte, du bord gauche, sans colonne de libellés. */
  .text > :global(p:first-child) {
    margin-top: 0;
  }

  /* Chaque partie s'ouvre comme une rubrique du CV : le titre sur un filet de 2 px. */
  .text > :global(h2) {
    margin-top: var(--space-8);
    padding-block: 0 var(--space-3);
    border-top: 0;
    border-bottom: var(--rule-heavy) solid var(--color-rule);
    font-size: var(--text-2xl);
  }

  /* Chaque rubrique est une ligne, comme les domaines et les langues du CV : libellé en gras,
     puis le texte, sous un filet doux. */
  .text > :global(h3) {
    margin: var(--space-4) 0 0;
    padding-top: var(--space-4);
    border-top: var(--rule-thin) solid var(--color-rule-soft);
    font-size: var(--text-base);
    font-weight: var(--weight-bold);
    line-height: var(--leading-body);
  }

  .text > :global(h2 + h3) {
    border-top: 0;
  }

  .text > :global(h3 + p) {
    margin-top: var(--space-1);
  }

  /* Dès 40rem, le libellé dans une colonne de 12rem, comme sur le CV. Le filet court sous les
     deux colonnes : l'écart est une marge interne du texte. */
  @media (min-width: 40rem) {
    .text {
      display: grid;
      grid-template-columns: 12rem minmax(0, 1fr);
      max-width: calc(12rem + var(--space-5) + var(--measure));
    }

    .text > :global(*) {
      grid-column: 2;
      padding-left: var(--space-5);
    }

    .text > :global(:is(h2, h3, p:first-child)) {
      padding-left: 0;
    }

    .text > :global(p:first-child) {
      grid-column: 1 / -1;
    }

    .text > :global(h2) {
      grid-column: 1 / -1;
    }

    .text > :global(h3) {
      grid-column: 1;
    }

    .text > :global(h3 + p) {
      margin-top: var(--space-4);
      padding-top: var(--space-4);
      border-top: var(--rule-thin) solid var(--color-rule-soft);
    }

    .text > :global(h2 + h3 + p) {
      border-top: 0;
    }
  }

  /* Au-dessus de 64rem, la lecture à gauche et l'en-tête de partie à droite, collant, comme
     sur la page projet et le CV (colonne de 16 à 20rem). */
  @media (min-width: 64rem) {
    .legal {
      display: grid;
      grid-template-columns: minmax(0, 1fr) minmax(16rem, 20rem);
      column-gap: var(--space-8);
      align-items: start;
    }

    h1 {
      grid-column: 1 / -1;
    }

    .pgn {
      grid-column: 2;
      grid-row: 2 / span 2;
      position: sticky;
      top: var(--space-6);
      flex-direction: column;
      margin-top: var(--space-5);
      border-top: var(--rule-heavy) solid var(--color-rule);
    }

    .pgn > div + div {
      border-top: var(--rule-thin) solid var(--color-rule-soft);
    }

    .summary {
      grid-column: 1;
      grid-row: 2;
    }

    .text {
      grid-column: 1;
      grid-row: 3;
    }
  }
</style>
