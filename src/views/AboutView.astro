---
import { Picture } from 'astro:assets';
import { render } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import Trait from '../components/Trait.astro';
import portrait from '../assets/about/portrait.jpg';
import { getAvailability } from '../lib/availability';
import { getAboutPage } from '../lib/pages';
import { getLocale, useTranslations } from '../i18n/utils';

const locale = getLocale(Astro.currentLocale);
const t = useTranslations(locale);

const { entry, photoAlt } = await getAboutPage(locale);
const { Content } = await render(entry);
const availability = getAvailability(locale);
---

<BaseLayout title={entry.data.title} description={entry.data.description}>
  <article class="about">
    <h1>{entry.data.title}</h1>
    <Picture
      class="photo"
      src={portrait}
      alt={photoAlt}
      formats={['avif', 'webp']}
      fallbackFormat="webp"
      widths={[320, 640]}
      sizes="(max-width: 30rem) 100vw, 20rem"
      quality={60}
      loading="eager"
    />
    <div class="story">
      <Content />
    </div>
    {availability && (
      <section class="seeking" aria-labelledby="seeking">
        <h2 id="seeking">
          <Trait />
          {t('about.seeking')}
        </h2>
        <dl class="pgn">
          <div>
            <dt>{t('availability.label')}</dt>
            <dd>{availability.status}</dd>
          </div>
          {availability.start && (
            <div>
              <dt>{t('availability.start')}</dt>
              <dd>{availability.start}</dd>
            </div>
          )}
          <div>
            <dt>{t('availability.terms')}</dt>
            <dd>{availability.place}</dd>
          </div>
        </dl>
      </section>
    )}
  </article>
</BaseLayout>

<style>
  /* La colonne vide de droite porte les deux filets jusqu'au bord de la page, comme
     l'en-tête. */
  .about {
    display: grid;
    grid-template-columns: 20rem minmax(0, var(--measure)) 1fr;
    grid-template-areas:
      'title title title'
      'photo story .'
      'seeking seeking seeking';
    gap: var(--space-6) var(--space-8);
    align-items: start;
  }

  h1 {
    grid-area: title;
    margin: 0;
    padding-bottom: var(--space-4);
    border-bottom: var(--rule-heavy) solid var(--color-rule);
  }

  .about :global(.photo) {
    grid-area: photo;
    display: block;
    width: 100%;
    max-width: 20rem;
    height: auto;
  }

  .story {
    grid-area: story;
  }

  .story :global(p) {
    margin: 0 0 var(--space-4);
  }

  .story :global(p:last-child) {
    margin-bottom: 0;
  }

  .seeking {
    grid-area: seeking;
    margin-top: var(--space-5);
    padding-top: var(--space-5);
    border-top: var(--rule-heavy) solid var(--color-rule);
  }

  /* Section title de DESIGN.md : interligne 1.1, sans jeton. */
  h2 {
    display: flex;
    align-items: baseline;
    gap: var(--space-3);
    margin: 0 0 var(--space-3);
    font-size: var(--text-2xl);
    font-weight: var(--weight-black);
    font-stretch: var(--stretch-display);
    line-height: 1.1;
  }

  /* Au-dessus de 80rem, l'en-tête de partie occupe la colonne de droite, à côté du récit. */
  @media (min-width: 80rem) {
    .about {
      grid-template-columns: 20rem minmax(0, var(--measure)) minmax(16rem, 1fr);
      grid-template-areas:
        'title title title'
        'photo story seeking';
    }

    .seeking {
      margin-top: 0;
      padding-top: 0;
      border-top: 0;
    }

    h2 {
      font-size: var(--text-xl);
    }

    dl {
      flex-direction: column;
      border-top: var(--rule-heavy) solid var(--color-rule);
      border-bottom: var(--rule-thin) solid var(--color-rule);
    }

    dl > div + div {
      border-top: var(--rule-thin) solid var(--color-rule-soft);
    }
  }

  @media (max-width: 56rem) {
    .about {
      grid-template-columns: minmax(0, 1fr);
      grid-template-areas: 'title' 'photo' 'story' 'seeking';
    }
  }

  /* Sur téléphone, la photo prend toute la largeur : son bord droit rejoint les filets. */
  @media (max-width: 30rem) {
    .about :global(.photo) {
      max-width: none;
    }
  }
</style>
