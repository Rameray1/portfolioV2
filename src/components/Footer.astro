---
import { site } from '../data/site';
import { getLocale, useTranslations } from '../i18n/utils';

const t = useTranslations(getLocale(Astro.currentLocale));

const links = [
  { label: t('footer.email'), href: `mailto:${site.contact.email}` },
  { label: t('footer.github'), href: site.contact.github },
  { label: t('footer.linkedin'), href: site.contact.linkedin },
];
---

<footer>
  <div class="bar">
    <ul>
      {links.map((link) => (
        <li>
          <a href={link.href}>{link.label}</a>
        </li>
      ))}
    </ul>
  </div>
</footer>

<style>
  footer {
    border-top: var(--rule-heavy) solid var(--color-rule);
  }

  .bar {
    max-width: var(--page-max);
    margin-inline: auto;
    padding-inline: var(--gutter);
    padding-block: var(--space-6);
  }

  ul {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2) var(--space-5);
    margin: 0;
    padding: 0;
    list-style: none;
    font-size: var(--text-sm);
  }

  a {
    display: inline-block;
    padding-block: var(--space-1);
  }
</style>
