---
interface Props {
  class?: string;
  lang?: string;
}

// `attrs` porte la classe de l'appelant et son attribut de portée, comme pour Piece.
const { class: className, ...attrs } = Astro.props;
---

<div {...attrs} class:list={['prose', className]}>
  <slot />
</div>

<style>
  /* Texte écrit en Markdown (récit d'un projet, mentions légales). Chaque partie s'ouvre
     sur un filet doux et un titre en chasse étroite ; interligne 1.1 du Section title de
     DESIGN.md, sans jeton. */
  .prose :global(h2) {
    margin: var(--space-7) 0 0;
    padding-top: var(--space-3);
    border-top: var(--rule-thin) solid var(--color-rule-soft);
    font-size: var(--text-xl);
    font-weight: var(--weight-black);
    font-stretch: var(--stretch-display);
    line-height: 1.1;
  }

  .prose > :global(:first-child) {
    margin-top: 0;
  }

  .prose :global(:is(p, ul, ol)) {
    margin: var(--space-3) 0 0;
  }

  /* Note du commentateur (`> …` dans la fiche) : isolée entre deux filets, comme le coup
     clé ; son symbole éventuel se place dans la marge, que la vue réserve à gauche. */
  .prose :global(.note) {
    position: relative;
    margin: var(--space-5) 0 0;
    padding-block: var(--space-3);
    border-block: var(--rule-thin) solid var(--color-rule);
    font-size: var(--text-lg);
    font-weight: var(--weight-semibold);
    line-height: var(--leading-snug);
  }

  .prose :global(.note p) {
    margin: 0;
  }

  .prose :global(.note-mark) {
    position: absolute;
    right: calc(100% + var(--space-5));
    font-size: var(--text-2xl);
    font-weight: var(--weight-black);
    font-stretch: var(--stretch-display);
    line-height: 1;
  }

  /* Sous 40rem, pas de marge : le symbole passe à droite de la note. */
  @media (max-width: 40rem) {
    .prose :global(.note-mark) {
      position: static;
      float: right;
      margin-left: var(--space-3);
    }
  }
</style>
