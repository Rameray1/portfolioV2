---
import EvalMark from './EvalMark.astro';
import type { Eval, Project } from '../lib/projects';
import { getLocale, localizePath, useTranslations } from '../i18n/utils';

interface Props {
  projects: Project[];
  detail?: boolean;
}

const { projects, detail = false } = Astro.props;
const locale = getLocale(Astro.currentLocale);
const t = useTranslations(locale);

const symbols = (['!', '!?', '!!'] satisfies Eval[]).filter((symbol) =>
  projects.some((project) => project.eval === symbol),
);
---

{projects.length > 0 && (
  <>
    <ol>
      {projects.map((project) => {
        const fallback = project.untranslated && locale === 'en';
        const lang = fallback ? 'fr' : undefined;
        return (
          <li>
            <a href={localizePath(`/projects/${project.slug}/`, locale)}>
              <span class="when">
                {project.year}
                {!detail && project.move && (
                  <span class="notation">{project.move.notation}</span>
                )}
              </span>
              <span class="what">
                <span class="title">
                  <span lang={lang}>{project.title}</span>{' '}
                  {fallback && (
                    <span class="flag">{t('projects.frenchOnly')}</span>
                  )}
                  {project.draft && (
                    <span class="flag">{t('projects.draft')}</span>
                  )}
                </span>
                {detail ? (
                  <>
                    <span class="text" lang={lang}>
                      {project.summary}
                    </span>
                    <span class="text">{project.tech.join(' · ')}</span>
                  </>
                ) : (
                  <span class="text">
                    {t('projects.keyMove')}{' '}
                    <span lang={lang}>{project.keyMove}</span>
                  </span>
                )}
              </span>
              <span class="mark">
                <EvalMark eval={project.eval} />
              </span>
            </a>
          </li>
        );
      })}
    </ol>
    <ul class="legend" aria-label={t('projects.legend')}>
      {symbols.map((symbol) => (
        <li>
          <EvalMark eval={symbol} legend />
        </li>
      ))}
    </ul>
  </>
)}

<style>
  ol,
  ul {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  ol {
    border-top: var(--rule-heavy) solid var(--color-rule);
  }

  ol li {
    border-bottom: var(--rule-thin) solid var(--color-rule-soft);
  }

  /* Liste des coups de DESIGN.md : année 4.5rem, symbole 2.5rem. */
  a {
    display: grid;
    grid-template-columns: 4.5rem minmax(0, 1fr) 2.5rem;
    gap: var(--space-4);
    align-items: baseline;
    padding: var(--space-3) var(--space-2);
    text-decoration: none;
    transition:
      background-color var(--duration) var(--ease-out),
      color var(--duration) var(--ease-out);
  }

  /* Ligne inversée : EvalMark lit ces deux propriétés pour son symbole. */
  a:hover,
  a:focus-visible {
    background: var(--color-invert-bg);
    color: var(--color-invert-ink);
    outline-offset: 0;
    --eval-color: var(--color-mark-on-invert);
    --eval-color-brilliant: var(--color-brilliant-on-invert);
  }

  .when,
  .text {
    font-size: var(--text-sm);
    color: var(--color-ink-muted);
  }

  .notation {
    display: block;
    font-weight: var(--weight-bold);
    color: var(--color-ink);
  }

  .title {
    display: block;
    font-size: var(--text-lg);
    font-weight: var(--weight-bold);
    line-height: var(--leading-snug);
    overflow-wrap: anywhere;
  }

  .text {
    display: block;
    margin-top: var(--space-1);
    overflow-wrap: anywhere;
  }

  .flag {
    display: inline-block;
    margin-right: var(--space-1);
    padding: 0 var(--space-2);
    border: var(--rule-thin) solid currentColor;
    font-size: var(--text-xs);
    font-weight: var(--weight-semibold);
    line-height: var(--leading-body);
    vertical-align: middle;
    white-space: nowrap;
  }

  a:is(:hover, :focus-visible) :is(.when, .text, .notation) {
    color: inherit;
  }

  .mark {
    font-size: var(--text-2xl);
    line-height: 1;
    text-align: right;
  }

  .legend {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-1) var(--space-5);
    margin-top: var(--space-3);
    font-size: var(--text-xs);
    color: var(--color-ink-muted);
  }

  .legend :global(.symbol) {
    margin-right: var(--space-1);
    font-size: var(--text-sm);
  }

  /* Colonnes resserrées sous 56rem : valeurs du prototype validé. */
  @media (max-width: 56rem) {
    a {
      grid-template-columns: 3.25rem minmax(0, 1fr) 2rem;
      gap: var(--space-3);
    }
  }
</style>
