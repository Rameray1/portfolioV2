---
import { parseFen } from '../data/diagram';

interface Props {
  fen: string;
  label: string;
}

const { fen, label } = Astro.props;

const pieceUrls = Object.fromEntries(
  Object.entries(
    import.meta.glob<string>('../assets/pieces/*.svg', {
      eager: true,
      query: '?url',
      import: 'default',
    }),
  ).map(([path, url]) => [path.replace(/^.*\/(\w+)\.svg$/, '$1'), url]),
);

const pieces = parseFen(fen);
const ranks = [8, 7, 6, 5, 4, 3, 2, 1];
const files = ['a', 'b', 'c', 'd', 'e', 'f', 'g', 'h'];
---

<div class="frame">
  <div class="ranks" aria-hidden="true">
    {ranks.map((rank) => (
      <span>{rank}</span>
    ))}
  </div>
  <div class="board" role="img" aria-label={label}>
    {ranks.flatMap((rank) =>
      files.map((_, index) => (
        <span
          class:list={['square', { dark: (index + 1 + rank) % 2 === 0 }]}
          style={`--file: ${index + 1}; --rank: ${rank}`}
        />
      )),
    )}
    {pieces.map(({ piece, file, rank }) => (
      <img
        class="piece"
        src={pieceUrls[piece]}
        alt=""
        width="45"
        height="45"
        decoding="async"
        style={`--file: ${file}; --rank: ${rank}`}
      />
    ))}
  </div>
  <div class="files" aria-hidden="true">
    {files.map((file) => (
      <span>{file}</span>
    ))}
  </div>
</div>

<style>
  /* Gouttière des coordonnées : 1.25rem, valeur du prototype validé. */
  .frame {
    display: grid;
    grid-template-columns: 1.25rem minmax(0, 1fr);
    grid-template-rows: auto 1.25rem;
    gap: var(--space-1);
  }

  .board {
    display: grid;
    grid-template-columns: repeat(8, minmax(0, 1fr));
    grid-template-rows: repeat(8, minmax(0, 1fr));
    aspect-ratio: 1;
    border: var(--rule-heavy) solid var(--color-board-edge);
  }

  .square,
  .piece {
    grid-column: var(--file);
    grid-row: calc(9 - var(--rank));
  }

  .square {
    background: var(--color-square-light);
  }

  .square.dark {
    background: var(--color-square-dark);
  }

  .piece {
    width: 100%;
    height: 100%;
  }

  .ranks,
  .files {
    display: grid;
    font-size: var(--text-xs);
    color: var(--color-ink-muted);
    place-items: center;
  }

  .ranks {
    grid-template-rows: repeat(8, minmax(0, 1fr));
    padding-block: var(--rule-heavy);
  }

  .files {
    grid-column: 2;
    grid-template-columns: repeat(8, minmax(0, 1fr));
    padding-inline: var(--rule-heavy);
  }
</style>
