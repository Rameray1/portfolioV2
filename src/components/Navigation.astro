---
import { nav } from '../data/nav';
import { getLocale, localizePath, strip, useTranslations } from '../i18n/utils';

const locale = getLocale(Astro.currentLocale);
const t = useTranslations(locale);

const current = strip(Astro.url.pathname);

const items = nav.map((item) => {
  const href = localizePath(item.href, locale);
  const path = strip(href);
  const ariaCurrent =
    current === path
      ? ('page' as const)
      : current.startsWith(`${path}/`)
        ? ('true' as const)
        : undefined;
  return { label: t(item.key), href, ariaCurrent };
});
---

<nav aria-label={t('nav.label')}>
  <ul>
    {items.map((item) => (
      <li>
        <a href={item.href} aria-current={item.ariaCurrent}>
          {item.label}
        </a>
      </li>
    ))}
  </ul>
</nav>

<style>
  ul {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-1) var(--space-5);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  a {
    display: inline-block;
    padding-block: var(--space-1);
    font-size: var(--text-sm);
    text-decoration: none;
    text-underline-offset: var(--underline-offset-current);
  }

  a:hover,
  a[aria-current] {
    text-decoration-line: underline;
    text-decoration-thickness: var(--rule-heavy);
  }

  a[aria-current] {
    color: var(--color-mark);
    font-weight: var(--weight-semibold);
  }
</style>
