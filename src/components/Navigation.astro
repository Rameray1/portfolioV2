---
import { nav } from '../data/nav';
import { getLocale, localizePath, useTranslations } from '../i18n/utils';

const locale = getLocale(Astro.currentLocale);
const t = useTranslations(locale);

// Rubrique courante, calculée au build : la page elle-même ("page")
// ou une page placée sous son chemin ("true"), barre oblique finale ignorée.
const strip = (path: string) =>
  path.length > 1 ? path.replace(/\/+$/, '') : path;
const current = strip(Astro.url.pathname);

const items = nav.map((item) => {
  const frenchOnly = 'frenchOnly' in item && item.frenchOnly;
  const href = frenchOnly ? item.href : localizePath(item.href, locale);
  const path = strip(href);
  const ariaCurrent =
    current === path
      ? ('page' as const)
      : current.startsWith(`${path}/`)
        ? ('true' as const)
        : undefined;
  // Rubrique sans version dans cette langue : mention (FR), langue de la cible annoncée.
  // Espace insécable entre le libellé et la mention, pour qu'ils ne se séparent jamais.
  const marked = frenchOnly && locale !== 'fr';
  const label = marked
    ? `${t(item.key)}\u00a0${t('nav.frenchMark')}`
    : t(item.key);
  return {
    label,
    href,
    ariaCurrent,
    hreflang: marked ? ('fr' as const) : undefined,
    ariaLabel: marked ? `${label}, ${t('nav.inFrench')}` : undefined,
  };
});
---

<nav aria-label={t('nav.label')}>
  <ul>
    {items.map((item) => (
      <li>
        <a
          href={item.href}
          aria-current={item.ariaCurrent}
          hreflang={item.hreflang}
          aria-label={item.ariaLabel}
        >
          {item.label}
        </a>
      </li>
    ))}
  </ul>
</nav>

<style>
  ul {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-1) var(--space-5);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  a {
    display: inline-block;
    padding-block: var(--space-1);
    font-size: var(--text-sm);
    text-decoration: none;
    /* même position de trait au survol et pour la rubrique courante */
    text-underline-offset: var(--underline-offset-current);
  }

  a:hover,
  a[aria-current] {
    text-decoration-line: underline;
    text-decoration-thickness: var(--rule-heavy);
  }

  a[aria-current] {
    color: var(--color-mark);
    font-weight: var(--weight-semibold);
  }
</style>
