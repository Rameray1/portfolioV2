---
import { site } from '../data/site';
import Navigation from './Navigation.astro';
import LangSwitcher from './LangSwitcher.astro';
import { getLocale, localizePath, useTranslations } from '../i18n/utils';

const locale = getLocale(Astro.currentLocale);
const t = useTranslations(locale);
const home = localizePath('/', locale);
---

<header>
  <div class="bar">
    <a class="name" href={home}>
      {site.name}
    </a>
    <details class="menu">
      <summary>
        <svg class="burger" viewBox="0 0 16 16" aria-hidden="true">
          <line x1="2" y1="4" x2="14" y2="4"></line>
          <line x1="2" y1="8" x2="14" y2="8"></line>
          <line x1="2" y1="12" x2="14" y2="12"></line>
        </svg>
        <span class="visually-hidden">{t('nav.menu')}</span>
      </summary>
      <Navigation />
    </details>
    <div class="lang">
      <LangSwitcher />
    </div>
  </div>
</header>

<style>
  header {
    view-transition-name: site-header;
    border-bottom: var(--rule-heavy) solid var(--color-rule);
  }

  .bar {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto auto;
    grid-template-rows: auto auto;
    align-items: center;
    /* Les cibles de 44 px de la langue et du menu font déjà l'écart. */
    column-gap: 0;
    max-width: var(--page-max);
    margin-inline: auto;
    padding-inline: var(--gutter);
    padding-block: var(--space-3);
  }

  .name {
    grid-area: 1 / 1;
    justify-self: start;
    font-size: var(--text-base);
    font-weight: var(--weight-bold);
    text-decoration: none;
  }

  .name:hover {
    text-decoration-line: underline;
  }

  .lang {
    grid-area: 1 / 2;
  }

  .lang :global(a) {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-width: 2.75rem;
    min-height: 2.75rem;
  }

  /* Mobile : le menu couvre les deux lignes de la barre ; seul le résumé
     et la liste dépliée captent le pointeur, le nom et la langue restent cliquables. */
  .menu {
    display: grid;
    grid-template-columns: subgrid;
    grid-template-rows: subgrid;
    grid-column: 1 / -1;
    grid-row: 1 / span 2;
    pointer-events: none;
  }

  .menu::details-content {
    grid-column: 1 / -1;
    grid-row: 2;
    pointer-events: auto;
  }

  summary {
    grid-area: 1 / 3;
    display: inline-flex;
    align-items: center;
    /* Icône centrée pour le surlignage au toucher ; la cible déborde dans la marge
       pour que l'icône reste calée sur les filets. */
    justify-content: center;
    margin-inline-end: calc(var(--space-3) * -1);
    min-width: 2.75rem;
    min-height: 2.75rem;
    list-style: none;
    cursor: pointer;
    pointer-events: auto;
  }

  /* La cible touche presque le bord de l'écran à 320 px : l'anneau passe à l'intérieur. */
  summary:focus-visible {
    outline-offset: calc(var(--focus-width) * -1);
  }

  summary::-webkit-details-marker {
    display: none;
  }

  /* 1.25rem : taille propre à l'icône, centrée dans 2.75rem. */
  .burger {
    width: 1.25rem;
    height: 1.25rem;
    stroke: currentColor;
    stroke-width: var(--rule-heavy);
  }

  .burger line {
    transform-origin: 8px 8px;
    transition:
      transform var(--duration) var(--ease-out),
      opacity var(--duration) var(--ease-out);
  }

  /* Ouvert, les traits du haut et du bas rejoignent le centre et forment une croix. */
  .menu[open] .burger line:nth-child(1) {
    transform: rotate(45deg) translateY(4px);
  }

  .menu[open] .burger line:nth-child(2) {
    opacity: 0;
  }

  .menu[open] .burger line:nth-child(3) {
    transform: rotate(-45deg) translateY(-4px);
  }

  .menu :global(ul) {
    flex-direction: column;
    gap: 0;
    margin-top: var(--space-2);
    border-top: var(--rule-thin) solid var(--color-rule-soft);
  }

  .menu :global(li + li) {
    border-top: var(--rule-thin) solid var(--color-rule-soft);
  }

  /* Cible tactile de 44 px (2.75rem) par rubrique. */
  .menu :global(a) {
    display: flex;
    align-items: center;
    min-height: 2.75rem;
  }

  @media (min-width: 48rem) {
    .bar {
      grid-template-columns: auto minmax(0, 1fr) auto;
      grid-template-rows: auto;
      column-gap: var(--space-6);
      padding-block: var(--space-5);
    }

    .lang {
      grid-area: 1 / 3;
    }

    .lang :global(a) {
      display: inline-block;
      min-width: 0;
      min-height: 0;
    }

    .menu {
      display: block;
      grid-column: 2;
      grid-row: 1;
      justify-self: end;
      pointer-events: auto;
    }

    .menu :global(ul) {
      flex-direction: row;
      gap: var(--space-1) var(--space-5);
      margin-top: 0;
      border-top: 0;
    }

    .menu :global(li + li) {
      border-top: 0;
    }

    .menu :global(a) {
      display: inline-block;
      min-height: 0;
    }

    /* Sans ::details-content, le bureau garde « Menu » plutôt que de perdre la navigation. */
    @supports selector(::details-content) {
      summary {
        display: none;
      }

      .menu::details-content {
        content-visibility: visible;
      }
    }
  }
</style>
