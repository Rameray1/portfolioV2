---
import { site } from '../data/site';
import Navigation from './Navigation.astro';
import LangSwitcher from './LangSwitcher.astro';
import { getLocale, localizePath, useTranslations } from '../i18n/utils';

const locale = getLocale(Astro.currentLocale);
const t = useTranslations(locale);
const home = localizePath('/', locale);
---

<header>
  <div class="bar">
    <a class="name" href={home}>
      {site.name}
    </a>
    <details class="menu">
      <summary>{t('nav.menu')}</summary>
      <Navigation />
    </details>
    <div class="lang">
      <LangSwitcher />
    </div>
  </div>
</header>

<style>
  header {
    border-bottom: var(--rule-heavy) solid var(--color-rule);
  }

  .bar {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto auto;
    grid-template-rows: auto auto;
    align-items: center;
    column-gap: var(--space-5);
    max-width: var(--page-max);
    margin-inline: auto;
    padding-inline: var(--gutter);
    padding-block: var(--space-3);
  }

  .name {
    grid-area: 1 / 1;
    justify-self: start;
    font-size: var(--text-base);
    font-weight: var(--weight-bold);
    text-decoration: none;
  }

  .name:hover {
    text-decoration-line: underline;
  }

  .lang {
    grid-area: 1 / 3;
  }

  /* Mobile : le menu couvre les deux lignes de la barre ; seul le résumé
     et la liste dépliée captent le pointeur, le nom et la langue restent cliquables. */
  .menu {
    display: grid;
    grid-template-columns: subgrid;
    grid-template-rows: subgrid;
    grid-column: 1 / -1;
    grid-row: 1 / span 2;
    pointer-events: none;
  }

  .menu::details-content {
    grid-column: 1 / -1;
    grid-row: 2;
    pointer-events: auto;
  }

  summary {
    grid-area: 1 / 2;
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    min-height: 2.75rem;
    font-size: var(--text-sm);
    font-weight: var(--weight-semibold);
    list-style: none;
    cursor: pointer;
    pointer-events: auto;
  }

  summary::-webkit-details-marker {
    display: none;
  }

  /* Chevron dessiné en CSS : 0.4rem de côté, tourné à l'ouverture. */
  summary::after {
    content: '';
    width: 0.4rem;
    height: 0.4rem;
    border-right: var(--rule-heavy) solid currentColor;
    border-bottom: var(--rule-heavy) solid currentColor;
    transform: translateY(-0.1rem) rotate(45deg);
    transition: transform var(--duration) var(--ease-out);
  }

  .menu[open] summary::after {
    transform: translateY(0.1rem) rotate(-135deg);
  }

  summary:hover {
    text-decoration-line: underline;
    text-decoration-thickness: var(--rule-heavy);
    text-underline-offset: var(--underline-offset-current);
  }

  .menu :global(ul) {
    flex-direction: column;
    gap: 0;
    margin-top: var(--space-2);
    border-top: var(--rule-thin) solid var(--color-rule-soft);
  }

  .menu :global(li + li) {
    border-top: var(--rule-thin) solid var(--color-rule-soft);
  }

  /* Cible tactile de 44 px (2.75rem) par rubrique. */
  .menu :global(a) {
    display: flex;
    align-items: center;
    min-height: 2.75rem;
  }

  @media (min-width: 48rem) {
    .bar {
      grid-template-columns: auto minmax(0, 1fr) auto;
      grid-template-rows: auto;
      column-gap: var(--space-6);
      padding-block: var(--space-5);
    }

    .lang {
      grid-area: 1 / 3;
    }

    .menu {
      display: block;
      grid-column: 2;
      grid-row: 1;
      justify-self: end;
      pointer-events: auto;
    }

    .menu :global(ul) {
      flex-direction: row;
      gap: var(--space-1) var(--space-5);
      margin-top: 0;
      border-top: 0;
    }

    .menu :global(li + li) {
      border-top: 0;
    }

    .menu :global(a) {
      display: inline-block;
      min-height: 0;
    }

    /* Sans ::details-content, le bureau garde « Menu » plutôt que de perdre la navigation. */
    @supports selector(::details-content) {
      summary {
        display: none;
      }

      .menu::details-content {
        content-visibility: visible;
      }
    }
  }
</style>
