---
import { site } from '../data/site';
import Navigation from './Navigation.astro';
import LangSwitcher from './LangSwitcher.astro';
import { getLocale, localizePath } from '../i18n/utils';

const home = localizePath('/', getLocale(Astro.currentLocale));
---

<header>
  <div class="bar">
    <a class="name" href={home}>
      {site.name}
    </a>
    <div class="nav">
      <Navigation />
    </div>
    <div class="lang">
      <LangSwitcher />
    </div>
  </div>
</header>

<style>
  header {
    border-bottom: var(--rule-heavy) solid var(--color-rule);
  }

  /* Mobile : le nom et la langue sur la première ligne, les rubriques dessous.
     Large : nom à gauche, rubriques puis langue à droite (DESIGN.md, Navigation). */
  .bar {
    display: grid;
    grid-template-columns: 1fr auto;
    grid-template-areas:
      'name lang'
      'nav nav';
    align-items: baseline;
    gap: var(--space-2) var(--space-6);
    max-width: var(--page-max);
    margin-inline: auto;
    padding-inline: var(--gutter);
    padding-block: var(--space-5);
  }

  .nav {
    grid-area: nav;
  }

  .lang {
    grid-area: lang;
  }

  @media (min-width: 48rem) {
    .bar {
      grid-template-columns: auto 1fr auto;
      grid-template-areas: 'name nav lang';
    }

    .nav {
      justify-self: end;
    }
  }

  .name {
    grid-area: name;
    justify-self: start;
    font-size: var(--text-base);
    font-weight: var(--weight-bold);
    text-decoration: none;
  }

  .name:hover {
    text-decoration-line: underline;
  }
</style>
