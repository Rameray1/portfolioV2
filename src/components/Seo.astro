---
import { PUBLIC_NOINDEX } from 'astro:env/client';
import { site } from '../data/site';
import { isNoindexPath } from '../data/seo';
import {
  alternatePath,
  getLocale,
  isStatusPage,
  localizePath,
  useTranslations,
} from '../i18n/utils';
import type { Locale } from '../i18n/ui';

interface Props {
  title: string;
  description: string;
  image?: { src: `/${string}`; alt: string };
  // Contenu sans version anglaise : la page `/en` affiche le français.
  untranslated?: boolean;
}

const { title, description, image, untranslated = false } = Astro.props;
const locale = getLocale(Astro.currentLocale);
const t = useTranslations(locale);
const pathname = Astro.url.pathname;
const statusPage = isStatusPage(pathname);

const ogLocales = { fr: 'fr_FR', en: 'en_US' } satisfies Record<Locale, string>;

const absolute = (path: string) =>
  new URL(
    path.endsWith('/') || path.includes('.') ? path : `${path}/`,
    Astro.site,
  ).href;

const documentTitle = title === site.name ? title : `${title} · ${site.name}`;
const fallback = untranslated && locale === 'en';
const canonical = statusPage
  ? undefined
  : absolute(fallback ? localizePath(pathname, 'fr') : pathname);
const robots = PUBLIC_NOINDEX
  ? 'noindex, nofollow'
  : statusPage || fallback || isNoindexPath(pathname)
    ? 'noindex'
    : undefined;
const alternate =
  statusPage || untranslated ? undefined : alternatePath(pathname, locale);
const otherLocale: Locale = locale === 'fr' ? 'en' : 'fr';
const alternates = alternate && {
  fr: absolute(localizePath(pathname, 'fr')),
  en: absolute(localizePath(pathname, 'en')),
};
const ogImage = absolute(image?.src ?? `/og/default-${locale}.png`);
const ogImageAlt = image?.alt ?? t('seo.ogImageAlt');
---

<title>{documentTitle}</title>
<meta name="description" content={description} />
{canonical && <link rel="canonical" href={canonical} />}
{alternates && (
  <>
    <link rel="alternate" hreflang="fr" href={alternates.fr} />
    <link rel="alternate" hreflang="en" href={alternates.en} />
    <link rel="alternate" hreflang="x-default" href={alternates.fr} />
  </>
)}
{robots && <meta name="robots" content={robots} />}
<meta property="og:type" content="website" />
<meta property="og:site_name" content={site.name} />
<meta property="og:title" content={documentTitle} />
<meta property="og:description" content={description} />
{canonical && <meta property="og:url" content={canonical} />}
<meta property="og:locale" content={ogLocales[locale]} />
{alternates && (
  <meta property="og:locale:alternate" content={ogLocales[otherLocale]} />
)}
<meta property="og:image" content={ogImage} />
<meta property="og:image:width" content="1200" />
<meta property="og:image:height" content="630" />
<meta property="og:image:alt" content={ogImageAlt} />
<meta name="twitter:card" content="summary_large_image" />
